# Shared drafts database (Postgres). Copy to .env for local development.
# Use a DIRECT connection string (postgres:// or postgresql://), not the
# prisma+postgres:// Accelerate URL. Without it, `npm run dev` stores the
# workspace in .data/workspace.json instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: require a shared team passcode for the drafts API.
# PRICER_PASSCODE=""
